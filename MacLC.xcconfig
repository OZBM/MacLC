// MacLC.xcconfig: build settings of MacLC.xcodeproj (both at the repository root).
//
// The core (libvlccore, every other plugin, contribs) keeps its autotools
// build in build/. Xcode builds the macOS interface plugin natively
// (libmacosx_plugin.dylib) against that tree and deploys it into
// build/MacLC.app, so build/ must be configured and packaged once first:
//   scheme "MacLC-Package" (runs `make -j12 package-macosx` in build/)
// then:
//   scheme "MacLC" (builds the plugin, deploys it, runs build/MacLC.app)
//
// Flags mirror modules/gui/macosx/Makefile.am; keep the two in sync.

MACLC_ROOT = $(SRCROOT)
MACLC_BUILD = $(MACLC_ROOT)/build
// The bundle the plugin is deployed into. A worktree builds against the main
// checkout's MACLC_BUILD and deploys into a copy of its bundle, e.g.
// xcodebuild ... MACLC_BUILD=<main>/build MACLC_APP=<copy>/MacLC.app
// (nibs are only compiled and copied when deploying into MACLC_BUILD's bundle).
MACLC_APP = $(MACLC_BUILD)/MacLC.app

SDKROOT = macosx
// The newest target Xcode 27.2 accepts; configure --with-macosx-version-min,
// LSMinimumSystemVersion and the XIBs (270200) use the same.
MACOSX_DEPLOYMENT_TARGET = 27.2
ARCHS = arm64
ONLY_ACTIVE_ARCH = YES

PRODUCT_NAME = macosx_plugin
EXECUTABLE_PREFIX = lib
DYLIB_INSTALL_NAME_BASE = @rpath
SKIP_INSTALL = YES
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual
ENABLE_USER_SCRIPT_SANDBOXING = NO

// The synchronized folder's exception list does not reach files inside an
// excluded subfolder; keep the XCTest sources, the Core ML model (installed
// by make, not code-generated) and the nibs' sources out by path.
EXCLUDED_SOURCE_FILE_NAMES = */gui/macosx/tests/* *.mlpackage */gui/macosx/Resources/* */gui/macosx/UI/* */gui/macosx/shaders/VLCSnowShader.metal

// Same lookup as the make build: no header maps (several headers share a
// basename across subfolders) and no Clang modules.
USE_HEADERMAP = NO
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = NO
HEADER_SEARCH_PATHS = $(MACLC_BUILD)/modules $(MACLC_ROOT)/modules $(MACLC_BUILD) $(MACLC_ROOT)/modules/access $(MACLC_ROOT)/modules/codec $(MACLC_ROOT)/include $(MACLC_BUILD)/include /opt/homebrew/opt/jpeg-turbo/include /opt/homebrew/opt/libpng/include $(MACLC_ROOT)/compat/stdbit $(MACLC_ROOT)/modules/gui/macosx
GCC_PREPROCESSOR_DEFINITIONS = HAVE_CONFIG_H MODULE_STRING=\"macosx\" VLC_DYNAMIC_PLUGIN _INTL_REDIRECT_MACROS

// Swift in the plugin (mirrored by the swiftc rule in modules/gui/macosx/Makefile.am).
// Swift sees the Objective-C listed in the bridging header; Objective-C imports
// "MacLC-Swift.h" for the @objc Swift API. Interface code runs on the main
// actor, as Xcode 27.2 sets up new app targets, in the Swift 6 language mode.
SWIFT_VERSION = 6.0
SWIFT_OBJC_BRIDGING_HEADER = modules/gui/macosx/MacLC-Bridging-Header.h
SWIFT_OBJC_INTERFACE_HEADER_NAME = MacLC-Swift.h
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_COMPILATION_MODE = wholemodule
SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_OPTIMIZATION_LEVEL[config=Debug] = -Onone

CLANG_ENABLE_OBJC_ARC = YES
GCC_ENABLE_OBJC_EXCEPTIONS = YES
GCC_SYMBOLS_PRIVATE_EXTERN = YES
GCC_INLINES_ARE_PRIVATE_EXTERN = YES
OTHER_CFLAGS = -mbranch-protection=standard -funroll-loops
WARNING_CFLAGS = -Wall -Wextra -Wsign-compare -Wundef -Wpointer-arith -Wvolatile-register-var -Wformat -Wformat-security -Werror=partial-availability

LIBRARY_SEARCH_PATHS = $(MACLC_BUILD)/src/.libs
OTHER_LDFLAGS = -lvlccore $(MACLC_BUILD)/compat/.libs/libcompat.a -framework AVKit -framework AVFoundation -framework Cocoa -framework CoreAudio -framework CoreGraphics -framework CoreMedia -framework CoreVideo -framework IOKit -framework QuartzCore -framework SystemConfiguration -framework ScriptingBridge -framework WebKit -framework QuickLook -framework QuickLookThumbnailing -framework Metal -framework MetalKit -framework VideoToolbox -framework UniformTypeIdentifiers -weak_framework MediaPlayer -Wl,-headerpad_max_install_names

DEBUG_INFORMATION_FORMAT = dwarf-with-dsym

// Xcode 27.2 recommended settings, from the Base_ProjectSettings template a
// new macOS project gets. The make build does not read them. Deviations:
// ENABLE_USER_SCRIPT_SANDBOXING stays NO (the deploy phase writes into
// build/MacLC.app), and the C standard matches the make build's Objective-C
// default (gnu17; maclc_frc_geometry.c keeps -std=gnu23 per file).
GCC_C_LANGUAGE_STANDARD = gnu17
CLANG_CXX_LANGUAGE_STANDARD = gnu++20
CLANG_ENABLE_OBJC_WEAK = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
GCC_NO_COMMON_BLOCKS = YES
GCC_DYNAMIC_NO_PIC = NO
COPY_PHASE_STRIP = NO
DEAD_CODE_STRIPPING = YES
ENABLE_NS_ASSERTIONS[config=Release] = NO
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
CLANG_ANALYZER_NONNULL = YES
CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION = YES_AGGRESSIVE
CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING = YES
CLANG_WARN_BOOL_CONVERSION = YES
CLANG_WARN_COMMA = YES
CLANG_WARN_CONSTANT_CONVERSION = YES
CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS = YES
CLANG_WARN_DIRECT_OBJC_ISA_USAGE = YES_ERROR
// Off: the core headers' Doxygen comments raise about 2,000 -Wdocumentation
// warnings that say nothing about the interface code.
CLANG_WARN_DOCUMENTATION_COMMENTS = NO
CLANG_WARN_EMPTY_BODY = YES
CLANG_WARN_ENUM_CONVERSION = YES
CLANG_WARN_INFINITE_RECURSION = YES
CLANG_WARN_INT_CONVERSION = YES
CLANG_WARN_NON_LITERAL_NULL_CONVERSION = YES
CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF = YES
CLANG_WARN_OBJC_LITERAL_CONVERSION = YES
CLANG_WARN_OBJC_ROOT_CLASS = YES_ERROR
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = YES
CLANG_WARN_RANGE_LOOP_ANALYSIS = YES
// Off for the same reason: about 350 -Wstrict-prototypes warnings, all in
// core headers declared with empty parameter lists.
CLANG_WARN_STRICT_PROTOTYPES = NO
CLANG_WARN_SUSPICIOUS_MOVE = YES
CLANG_WARN_UNGUARDED_AVAILABILITY = YES_AGGRESSIVE
CLANG_WARN_UNREACHABLE_CODE = YES
CLANG_WARN__DUPLICATE_METHOD_MATCH = YES
GCC_WARN_64_TO_32_BIT_CONVERSION = YES
GCC_WARN_ABOUT_RETURN_TYPE = YES_ERROR
GCC_WARN_UNDECLARED_SELECTOR = YES
GCC_WARN_UNINITIALIZED_AUTOS = YES_AGGRESSIVE
GCC_WARN_UNUSED_FUNCTION = YES
GCC_WARN_UNUSED_VARIABLE = YES

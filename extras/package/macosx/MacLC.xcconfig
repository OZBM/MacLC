// MacLC.xcconfig: build settings of MacLC.xcodeproj.
//
// The core (libvlccore, every other plugin, contribs) keeps its autotools
// build in build/. Xcode builds the macOS interface plugin natively
// (libmacosx_plugin.dylib) against that tree and deploys it into
// build/MacLC.app, so build/ must be configured and packaged once first:
//   scheme "MacLC-Package" (runs `make -j12 package-macosx` in build/)
// then:
//   scheme "MacLC" (builds the plugin, deploys it, runs build/MacLC.app)
//
// Flags mirror modules/gui/macosx/Makefile.am; keep the two in sync.

MACLC_ROOT = $(SRCROOT)/../../..
MACLC_BUILD = $(MACLC_ROOT)/build

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 26.0
ARCHS = arm64
ONLY_ACTIVE_ARCH = YES

PRODUCT_NAME = macosx_plugin
EXECUTABLE_PREFIX = lib
DYLIB_INSTALL_NAME_BASE = @rpath
SKIP_INSTALL = YES
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual
ENABLE_USER_SCRIPT_SANDBOXING = NO

// The synchronized folder's exception list does not reach files inside an
// excluded subfolder; keep the XCTest sources, the Core ML model (installed
// by make, not code-generated) and the nibs' sources out by path.
EXCLUDED_SOURCE_FILE_NAMES = */gui/macosx/tests/* *.mlpackage */gui/macosx/Resources/* */gui/macosx/UI/* */gui/macosx/shaders/VLCSnowShader.metal

// Same lookup as the make build: no header maps (several headers share a
// basename across subfolders) and no Clang modules.
USE_HEADERMAP = NO
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = NO
HEADER_SEARCH_PATHS = $(MACLC_BUILD)/modules $(MACLC_ROOT)/modules $(MACLC_BUILD) $(MACLC_ROOT)/modules/access $(MACLC_ROOT)/modules/codec $(MACLC_ROOT)/include $(MACLC_BUILD)/include /opt/homebrew/opt/jpeg-turbo/include /opt/homebrew/opt/libpng/include $(MACLC_ROOT)/compat/stdbit $(MACLC_ROOT)/modules/gui/macosx
GCC_PREPROCESSOR_DEFINITIONS = HAVE_CONFIG_H MODULE_STRING=\"macosx\" VLC_DYNAMIC_PLUGIN _INTL_REDIRECT_MACROS

CLANG_ENABLE_OBJC_ARC = YES
GCC_ENABLE_OBJC_EXCEPTIONS = YES
GCC_SYMBOLS_PRIVATE_EXTERN = YES
GCC_INLINES_ARE_PRIVATE_EXTERN = YES
OTHER_CFLAGS = -mbranch-protection=standard -funroll-loops
WARNING_CFLAGS = -Wall -Wextra -Wsign-compare -Wundef -Wpointer-arith -Wvolatile-register-var -Wformat -Wformat-security -Werror=partial-availability

LIBRARY_SEARCH_PATHS = $(MACLC_BUILD)/src/.libs
OTHER_LDFLAGS = -lvlccore $(MACLC_BUILD)/compat/.libs/libcompat.a -framework AVKit -framework AVFoundation -framework Cocoa -framework CoreAudio -framework CoreGraphics -framework CoreMedia -framework CoreVideo -framework IOKit -framework QuartzCore -framework SystemConfiguration -framework ScriptingBridge -framework WebKit -framework QuickLook -framework QuickLookThumbnailing -framework Metal -framework MetalKit -framework UniformTypeIdentifiers -weak_framework MediaPlayer -Wl,-headerpad_max_install_names

DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
